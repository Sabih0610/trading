# Copy to .env and fill in values yourself. NEVER put real values in this file.
# Every key is optional: if empty, the related feature is disabled and mocks are used.

# --- Binance (Testnet first; trade-only permissions, NO withdrawals, IP-restricted) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Macro / calendar / news (added later) ---
FRED_API_KEY=
FINNHUB_API_KEY=
CRYPTOPANIC_API_KEY=
NEWSDATA_API_KEY=

# --- AI providers (added later; monthly caps enforced in config/ai_budget.yaml) ---
XAI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
JEV_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# --- Notifications (added later) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional read-only MT5 data (attach to an already authenticated demo terminal) ---
MT5_TERMINAL_PATH=
MT5_DEMO_LOGIN=
MT5_DEMO_SERVER=
MT5_MCP_TOKEN=

# --- Optional OANDA Practice data; region/API/rights approval separately required ---
OANDA_PRACTICE_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=

# --- Optional Twelve Data Basic reference market data; never execution ---
TWELVE_DATA_API_KEY=

# --- Optional cTrader demo view-only data; owner obtains accounts scope separately ---
CTRADER_DEMO_CLIENT_ID=
CTRADER_DEMO_CLIENT_SECRET=
CTRADER_DEMO_ACCESS_TOKEN=
CTRADER_DEMO_ACCOUNT_ID=
CTRADER_DEMO_ACCESS_EXPIRES_AT=
CTRADER_DEMO_REFRESH_TOKEN=
CTRADER_DEMO_TOKEN_TYPE=
CTRADER_DEMO_TOKEN_ISSUED_AT=
CTRADER_DEMO_REQUESTED_SCOPE=
CTRADER_DEMO_BROKER_PIN=
CTRADER_DEMO_VERIFIED_BROKER=
CTRADER_DEMO_ACCOUNT_FINGERPRINT=
CTRADER_DEMO_ACCOUNT_ACCESS_RIGHTS=
CTRADER_DEMO_TOKEN_PERMISSION=
CTRADER_DEMO_APPLICATION_APPROVED=
CTRADER_DEMO_OAUTH_ENABLED=
CTRADER_DEMO_OAUTH_APPLICATION_BINDING=
CTRADER_DEMO_OAUTH_REDIRECT_URI=
CTRADER_DEMO_OAUTH_CALLBACK_STATE=
CTRADER_DEMO_OAUTH_VERIFIED_AT=
